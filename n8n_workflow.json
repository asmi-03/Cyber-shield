{
    "name": "CyberShield AI Agent",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "ai-chat",
                "responseMode": "responseNode",
                "options": {}
            },
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                0,
                0
            ],
            "id": "webhook-node",
            "name": "Webhook"
        },
        {
            "parameters": {
                "resource": "chat",
                "model": "gpt-3.5-turbo",
                "prompt": "={{ $json.body.message }}"
            },
            "type": "n8n-nodes-base.openai",
            "typeVersion": 1,
            "position": [
                250,
                0
            ],
            "id": "openai-node",
            "name": "OpenAI"
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "{\n  \"reply\": \"{{ $json.content }}\"\n}",
                "options": {}
            },
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1,
            "position": [
                500,
                0
            ],
            "id": "respond-node",
            "name": "Respond to Webhook"
        }
    ],
    "connections": {
        "Webhook": {
            "main": [
                [
                    {
                        "node": "OpenAI",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "OpenAI": {
            "main": [
                [
                    {
                        "node": "Respond to Webhook",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}